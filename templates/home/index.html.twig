{% if is_granted('ROLE_ADMIN') %}
<h2>Bienvenue {{ app.user.prenom }}</h2>
<p>Vous êtes administrateur de l’application.</p>

{% elseif is_granted('ROLE_EMPLOYEE') %}
<h2>Bienvenue {{ app.user.prenom }} 👋</h2>
<p>Vous êtes employé de l’association.</p>

{% else %}
<h2>Bienvenue {{ app.user.prenom }}</h2>
<p>Vous êtes client.</p>
{% endif %}