{% extends 'base.html.twig' %}

{% block title %}User{% endblock %}

{% block body %}
<div class="container mt-5 pt-4">
    <h1>User</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ user.id }}</td>
            </tr>
            <tr>
                <th>Email</th>
                <td>{{ user.email }}</td>
            </tr>
            <tr>
                <th>Roles</th>
                <td>{{ user.roles ? user.roles|json_encode : '' }}</td>
            </tr>

            <tr>
                <th>Nom</th>
                <td>{{ user.nom }}</td>
            </tr>
            <tr>
                <th>Prénom</th>
                <td>{{ user.prenom }}</td>
            </tr>
        </tbody>
    </table>

    <div class="mt-4 d-flex align-items-center">
        <a href="{{ path('app_user_index') }}">
            ← Retour à la liste
        </a>

        <a href="{{ path('app_user_edit', {'id': user.id}) }}" class="ms-auto">
            edit
        </a>
    </div>







    {{ include('user/_delete_form.html.twig') }}

</div>


{% endblock %}