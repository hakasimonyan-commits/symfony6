{% extends 'base.html.twig' %}

{% block title %}Utilisateurs{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1>Liste des utilisateurs</h1>

    <ul>
        {% for user in users %}
        <li>{{ user.prenom }} {{ user.nom }} – {{ user.email }}</li>
        {% endfor %}
    </ul>
</div>

{% endblock %}