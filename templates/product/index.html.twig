{% extends 'base.html.twig' %}

{% block title %}Produits{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1>Liste des produits</h1>

    <ul>
        {% for product in products %}
        <li>
            {{ product.name }} – {{ product.price }} €
            ({{ product.category.name }})
        </li>
        {% else %}
        <li>Aucun produit</li>
        {% endfor %}
    </ul>
</div>
{% endblock %}